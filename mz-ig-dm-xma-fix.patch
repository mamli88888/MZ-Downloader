+    raw_xma (dict خام که instagrapi حفظ می‌کند) هم اضافه می‌شود.
+    """
+    payloads: list[dict[str, Any]] = []
+    for attr in ("media_share", "clip", "reel_share", "xma_share", "felix_share"):
