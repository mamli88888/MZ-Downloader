BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ACCOUNTS=[{"name":"Account-1","api_id":123456,"api_hash":"replace-me","string_session":"replace-with-telethon-string-session"}]

# --- yt-dlp + bgutil PO Token gateway (YouTube only) --------------------
# This is the PRIMARY YouTube downloader. When YTDLP_ENABLED=true, YouTube
# links go to yt-dlp + bgutil first; Cobalt (if configured) and the Telegram
# backup bots are tried only as fallbacks.
#
# Prerequisites:
#   1. pip install bgutil-ytdlp-pot-provider   (already in requirements.txt)
#   2. Start the bgutil PO Token server:
#        docker compose -f docker-compose.bgutil.yml up -d
#      Verify with: curl http://127.0.0.1:4416/ping
#
# Cookies are OPTIONAL but recommended. Export cookies.txt from your browser
# with the "Get cookies.txt LOCALLY" extension and place it next to bot.py.
# Cookies help with age-restricted videos and provide an extra layer of bot
# detection bypass when PO Token alone is not enough.
YTDLP_ENABLED=true
YTDLP_BGUTIL_BASE_URL=http://127.0.0.1:4416
YTDLP_COOKIES_FILE=cookies.txt
# Comma-separated list of YouTube InnerTube clients to try. Order matters.
# mweb = mobile web (rarely triggers SABR / bot detection)
# web = desktop web (higher quality, sometimes needs PO Token)
# Default: mweb,web (covers most cases)
YTDLP_PLAYER_CLIENTS=mweb,web

# --- Cobalt (self-hosted media downloader) ------------------------------
# Cobalt is the PRIMARY downloader for Instagram (and a fallback for YouTube
# when yt-dlp fails). It runs as a separate Node.js process inside the same
# container (see start.sh) and exposes a small HTTP API on port 9000.
#
# When COBALT_API_URL is set, Instagram links go to cobalt first.
# If cobalt fails (or isn't configured), the bot falls back to the Telegram
# downloader bots listed in INSTAGRAM_YOUTUBE_BOTS.
#
# Leave empty to disable cobalt and use the Telegram bots only.
COBALT_API_URL=http://127.0.0.1:9000/
# Optional: API key if your cobalt instance requires authentication.
# Cobalt API keys are issued by the instance owner (see cobalt docs).
COBALT_API_KEY=
# When true, cobalt is tried before the Telegram bots. Set to false to use
# cobalt only as a fallback (the bots are tried first).
COBALT_PRIORITY=true
# Path to ffmpeg binary — needed for cobalt's local-processing responses
# (merging high-quality YouTube video + audio streams client-side) and
# for yt-dlp's video+audio merge.
FFMPEG_PATH=/usr/bin/ffmpeg

PRIMARY_DOWNLOADER_BOT=download_it_bot
SECONDARY_DOWNLOADER_BOT=AllSavesBot
SPOTIFY_DOWNLOADER_BOT=spotifysavesbot
SOUNDCLOUD_DOWNLOADER_BOT=scload_bot
DOWNLOADER_BOTS=download_it_bot,AllSavesBot
INSTAGRAM_YOUTUBE_BOTS=ziyotech_instagram_downloaderbot,allsaverbot,instadowbot,download_it_bot,AllSavesBot
TIKTOK_DOWNLOADER_BOTS=download_it_bot,AllSavesBot
# Twitter/X: AllSavesBot first, then download_it_bot as fallback
TWITTER_BOTS=AllSavesBot,download_it_bot
# Spotify single track: SpotSeekBot → Dr_downloader_bot → spotifysavesbot
SPOTIFY_TRACK_BOTS=SpotSeekBot,Dr_downloader_bot,spotifysavesbot
# Spotify album/playlist primary bot (Dr_downloader_bot flow)
SPOTIFY_COLLECTION_PRIMARY_BOT=Dr_downloader_bot
# Gofile.io API tokens, comma-separated, for large-file uploads.
GOFILE_TOKENS=replace-with-gofile-token-1,replace-with-gofile-token-2
# How long (seconds) before uploaded Gofile content is auto-deleted.
GOFILE_DELETE_DELAY_SECONDS=3600
# Public URL of the deployed Cloudflare Worker, without a trailing slash.
CLOUDFLARE_WORKER_URL=https://gofile-proxy.example.workers.dev
# Optional key shared by the bot and Worker to prevent public enumeration.
CLOUDFLARE_WORKER_ACCESS_KEY=replace-with-a-long-random-key

DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=30
# 0 = no application-level download-size cap (Telegram/Railway limits still apply)
MAX_DOWNLOAD_SIZE_MB=0
MAX_LINKS_PER_MESSAGE=5
MAX_CONCURRENT_UPDATES=12
MAX_QUEUE_SIZE=50
WORKER_ACQUIRE_TIMEOUT_SECONDS=180
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60

WAIT_TIMEOUT_SECONDS=90
SELECTION_TTL_SECONDS=600
ALBUM_COLLECT_WINDOW_SECONDS=2.5
PREVIEW_GRACE_SECONDS=3
LATE_RESPONSE_COOLDOWN_SECONDS=180

MUSIC_FINDER_BOTS=whatisthismusicbot

USE_PROXY=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
