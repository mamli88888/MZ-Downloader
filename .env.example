BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ACCOUNTS=[{"name":"Account-1","api_id":123456,"api_hash":"replace-me","string_session":"replace-with-telethon-string-session"}]

# --- Multi-platform downloader (rotational sites scraper) ----------------
# When YOUTUBE_SITES_ENABLED=true, the bot downloads YouTube / TikTok /
# Instagram / SoundCloud links by scraping the loader.to / loaderr.to /
# y2mate.yt / downcloud.cc / downtik.to / igdown.io family of public
# converter sites in rotation. All six frontends share a common backend
# API (savenow.to / lbserver.xyz) and a common public API key — they only
# differ in which format strings they accept per platform:
#
#   YouTube:     360, 480, 720, 1080, 1440, 4k, mp3
#   TikTok:      360, 720, 1080, mp3
#   Instagram:   360, 720, 1080, mp3
#   SoundCloud:  mp3, m4a, wav, flac
#
# The bot tries each frontend in turn until one returns a usable download
# URL; if all fail, it falls back to the Telegram downloader bots (e.g.
# INSTAGRAM_YOUTUBE_BOTS, TIKTOK_DOWNLOADER_BOTS, SOUNDCLOUD_DOWNLOADER_BOT).
#
# No yt-dlp / cobalt / bgutil needed — this is pure HTTP scraping.
YOUTUBE_SITES_ENABLED=true
# Public API key published in each frontend's main.js bundle. Override only
# if the site rotates it (default works as of 2026-08).
YOUTUBE_SITES_API_KEY=dfcb6d76f2f6a9894gjkege8a4ab232222
# Comma-separated list of frontend domains to rotate through. The bot tries
# each in random order until one works. Defaults include the loader.to
# language variants (which proxy the API on their own domain) plus the two
# shared backend API servers used as direct fallback.
YOUTUBE_SITES_FRONTENDS=loader.to,en.loader.to,es.loader.to,de.loader.to,fr.loader.to,it.loader.to,pt.loader.to,ru.loader.to,ja.loader.to,zh.loader.to,nl.loader.to,pl.loader.to,p.savenow.to,p.lbserver.xyz
# How many frontends to try before giving up (default 6). 0 = try all of them.
YOUTUBE_SITES_MAX_ATTEMPTS=6
# How long (seconds) to wait for a single frontend's progress endpoint to
# return a download URL before rotating to the next one. Long videos can
# take 1-2 minutes to process, so keep this generous.
YOUTUBE_SITES_PROGRESS_TIMEOUT_SECONDS=180

PRIMARY_DOWNLOADER_BOT=download_it_bot
SECONDARY_DOWNLOADER_BOT=AllSavesBot
SPOTIFY_DOWNLOADER_BOT=spotifysavesbot
SOUNDCLOUD_DOWNLOADER_BOT=scload_bot
DOWNLOADER_BOTS=download_it_bot,AllSavesBot
INSTAGRAM_YOUTUBE_BOTS=ziyotech_instagram_downloaderbot,allsaverbot,instadowbot,download_it_bot,AllSavesBot
TIKTOK_DOWNLOADER_BOTS=download_it_bot,AllSavesBot
# Twitter/X: AllSavesBot first, then download_it_bot as fallback
TWITTER_BOTS=AllSavesBot,download_it_bot
# Spotify single track: SpotSeekBot → Dr_downloader_bot → spotifysavesbot
SPOTIFY_TRACK_BOTS=SpotSeekBot,Dr_downloader_bot,spotifysavesbot
# Spotify album/playlist primary bot (Dr_downloader_bot flow)
SPOTIFY_COLLECTION_PRIMARY_BOT=Dr_downloader_bot
# Gofile.io API tokens, comma-separated, for large-file uploads.
GOFILE_TOKENS=replace-with-gofile-token-1,replace-with-gofile-token-2
# How long (seconds) before uploaded Gofile content is auto-deleted.
GOFILE_DELETE_DELAY_SECONDS=3600
# Public URL of the deployed Cloudflare Worker, without a trailing slash.
CLOUDFLARE_WORKER_URL=https://gofile-proxy.example.workers.dev
# Optional key shared by the bot and Worker to prevent public enumeration.
CLOUDFLARE_WORKER_ACCESS_KEY=replace-with-a-long-random-key

DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=30
# 0 = no application-level download-size cap (Telegram/Railway limits still apply)
MAX_DOWNLOAD_SIZE_MB=0
MAX_LINKS_PER_MESSAGE=5
MAX_CONCURRENT_UPDATES=12
MAX_QUEUE_SIZE=50
WORKER_ACQUIRE_TIMEOUT_SECONDS=180
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60

WAIT_TIMEOUT_SECONDS=90
SELECTION_TTL_SECONDS=600
ALBUM_COLLECT_WINDOW_SECONDS=2.5
PREVIEW_GRACE_SECONDS=3
LATE_RESPONSE_COOLDOWN_SECONDS=180

MUSIC_FINDER_BOTS=whatisthismusicbot

USE_PROXY=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808
