BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ACCOUNTS=[{"name":"Account-1","api_id":123456,"api_hash":"replace-with-telethon-string-session"}]

# --- Apify: primary YouTube / Instagram download route ---------------------
# Create an Apify API token in Console → Settings → Integrations and add it
# only to your deployment's secret/environment variables. Never commit it.
# With APIFY_TOKENS set, the bot tries these Actors first:
#   YouTube   → streamers/youtube-video-downloader
#   Instagram → apify/instagram-scraper
# Put one or more comma-separated tokens here. They rotate round-robin; a token
# with a billing, quota, authorization or rate-limit error is skipped for the
# cooldown period and the next token is tried immediately. Never commit tokens.
APIFY_ENABLED=true
APIFY_TOKENS=replace-with-token-1,replace-with-token-2
# Backward compatibility only: APIFY_TOKEN=one-token also works if APIFY_TOKENS
# is absent. Quality and audio are selected by the user from Telegram buttons.
APIFY_RUN_TIMEOUT_SECONDS=360
APIFY_POLL_INTERVAL_SECONDS=3
APIFY_TOKEN_COOLDOWN_SECONDS=600

# --- VoidDL: PRIMARY YouTube downloader (https://voiddl.app) ----------------
# Per key: 20 downloads/minute and 10 GB download bandwidth/day. Multiple keys
# rotate instantly when one hits either cap. MORE KEYS = FASTER TRANSFERS:
# each key is an independent ~12-15 MB/s pipe, and parallel lanes are spread
# across all available keys automatically.
VOIDDL_ENABLED=true
VOIDDL_API_KEYS=vd_replace-with-key-1,vd_replace-with-key-2
VOIDDL_DAILY_BANDWIDTH_MB=10240
VOIDDL_PER_MINUTE_LIMIT=20
# Speed layer (defaults are sensible):
#   VOIDDL_PARALLEL_LANES       simultaneous ranged requests for a big file (8)
#   VOIDDL_PREFETCH             background-prefetch likely qualities (true)
#   VOIDDL_PREFETCH_COUNT       how many video qualities to warm up (2)
#   VOIDDL_PREFETCH_LANES       lanes per prefetched quality, saves tokens (4)
#   VOIDDL_PREFETCH_MAX_MB      never prefetch a format larger than this (512)
#   VOIDDL_PREFETCH_MIN_REMAINING_MB  keep this much daily bandwidth before
#                                     prefetching at all (2048)
#   VOIDDL_PREFETCH_TTL         seconds before an unclaimed prefetch dies (720)
VOIDDL_PARALLEL_LANES=8
VOIDDL_PREFETCH=true
VOIDDL_PREFETCH_COUNT=2
VOIDDL_PREFETCH_LANES=4
VOIDDL_PREFETCH_MAX_MB=512
VOIDDL_PREFETCH_MIN_REMAINING_MB=2048
VOIDDL_PREFETCH_TTL=720


# --- AHM7 primary downloader (TikTok / Instagram / Facebook / X / Reddit
#     / Snapchat / SoundCloud / CapCut / SnackVideo / Douyin) --------------
# When AHM7_ENABLED=true, links from these 10 platforms are downloaded via
# https://ahm7xmakki.com/api/alldl as the PRIMARY path. Fallback chain:
#     AHM7 → Apify (where applicable) → Telegram bots → error message.
# When the API returns a videoUrl but no audioUrl and the user picked the
# MP3 option, the audio is extracted via
#     ffmpeg -i input.mp4 -vn -c:a libmp3lame -b:a 192k output.mp3
# (ffmpeg is already installed in the Dockerfile).
AHM7_ENABLED=true
AHM7_API_URL=https://ahm7xmakki.com/api/alldl

# --- Yoinku primary downloader (YouTube) -----------------------------------
# Yoinku gives 30 requests/day AND 5 requests/minute PER API key. To stay
# under those caps, set YOINKU_API_KEYS to a comma-separated list of keys.
# The bot rotates them round-robin: when one key hits 30/day, the 31st
# request automatically uses the next key; when one hits 5/min, the very
# next request uses a different key (no waiting). Fallback chain:
#     Yoinku → Apify → Telegram bots → error message.
# Leave YOINKU_API_KEYS empty to disable Yoinku (YouTube falls back to
# Apify / Telegram bots).
YOINKU_ENABLED=true
YOINKU_API_BASE=https://yoinku.com/api/v1
YOINKU_API_KEYS=yk_gOmLIZFxKbJaDbLIdkOFxJtWhHkgFyvMKefsTmKulcyyWWavLprmhttKCMNMuHKw
YOINKU_DAILY_LIMIT=30
YOINKU_PER_MINUTE_LIMIT=5

# --- Telegram downloader bot usernames -------------------------------------
# Each list defines the Telegram-bot fallback order for the platforms that
# have a dedicated list. The union of all of these is also used as the
# generic fallback for platforms that don't have a dedicated list
# (Reddit / Snapchat / CapCut / SnackVideo / Douyin).
PRIMARY_DOWNLOADER_BOT=download_it_bot
SECONDARY_DOWNLOADER_BOT=AllSavesBot
SPOTIFY_DOWNLOADER_BOT=spotifysavesbot
SOUNDCLOUD_DOWNLOADER_BOT=scload_bot
DOWNLOADER_BOTS=download_it_bot,AllSavesBot
INSTAGRAM_YOUTUBE_BOTS=ziyotech_instagram_downloaderbot,allsaverbot,instadowbot,download_it_bot,AllSavesBot
TIKTOK_DOWNLOADER_BOTS=download_it_bot,AllSavesBot
# Twitter/X: AllSavesBot first, then download_it_bot as fallback
TWITTER_BOTS=AllSavesBot,download_it_bot
# Spotify single track: SpotSeekBot → Dr_downloader_bot → spotifysavesbot
SPOTIFY_TRACK_BOTS=SpotSeekBot,Dr_downloader_bot,spotifysavesbot
# Spotify album/playlist primary bot (Dr_downloader_bot flow)
SPOTIFY_COLLECTION_PRIMARY_BOT=Dr_downloader_bot
# --- Large-file host (Pixeldrain) -----------------------------------------
# Files larger than MAX_FILE_SIZE_MB (Telegram's chunk limit, default 30MB)
# are uploaded to Pixeldrain and the user gets a direct CDN link. Set
# PIXELDRAIN_API_KEY to your Pixeldrain API key (https://pixeldrain.com/api).
PIXELDRAIN_API_KEY=
PIXELDRAIN_DELETE_DELAY_SECONDS=1800

DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=30
# 0 = no application-level download-size cap (Telegram/Railway limits still apply)
MAX_DOWNLOAD_SIZE_MB=0
MAX_LINKS_PER_MESSAGE=5
MAX_CONCURRENT_UPDATES=12
MAX_QUEUE_SIZE=50
WORKER_ACQUIRE_TIMEOUT_SECONDS=180
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60

WAIT_TIMEOUT_SECONDS=90
SELECTION_TTL_SECONDS=600
ALBUM_COLLECT_WINDOW_SECONDS=2.5
PREVIEW_GRACE_SECONDS=3
LATE_RESPONSE_COOLDOWN_SECONDS=180

MUSIC_FINDER_BOTS=whatisthismusicbot

USE_PROXY=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# ═══════════════════ 1404 UPGRADE (v2) ═══════════════════
# --- New cloud platforms (Spotify / SoundCloud / Twitter / Facebook / Pinterest)
# v2 fix round — all five integrations now use VERIFIED downloader services:
#   Spotify    → scraper-mind/spotify-music-downloader  (input: track_urls=[{url}], residential proxy)
#   SoundCloud → easyapi/soundcloud-mp3-downloader      (input: links=[...]; direct signed CDN mp3)
#   Twitter/X  → apidojo/tweet-scraper                  (input: startUrls; bitrate variants)
#   Facebook   → apple_yang/facebook-video-audio-downloader (input: videoUrls; direct videoUrl/audioUrl)
#   Pinterest  → easyapi/pinterest-video-downloader (video, links) + fatihtahta/pinterest-scraper-search (images)
# SoundCloud playlists/albums and Spotify albums still go through the previous
# working chain. On any failure the exact pre-existing fallback chain for each
# platform runs unchanged. Set to false to keep YouTube/Instagram only.
APIFY_NEW_PLATFORMS_ENABLED=true

# --- Broken-token admin alerts (PV) ---
# Numeric Telegram user/chat id of the MAIN admin who receives token alerts
# AND the CreatorCrawl "key exhausted" notifications. Get it from @userinfobot.
# Without this, alerts are still recorded in the /tokens dashboard but not
# delivered as PV.
BOT_ADMIN_CHAT_ID=0
TOKEN_ALERTS_ENABLED=true
# Reminders: every 15 minutes, max 5 (fixed per operator spec).

# --- CreatorCrawl — /profile Instagram feature ----------------------------
# https://creatorcrawl.com — free plan = 50 credits per account (1 credit per
# request). Register SEVERAL accounts and list the keys as comma-separated
# API_KEY|EMAIL pairs. The email identifies which account each key belongs
# to: when a key reaches CREATORCRAWL_KEY_LIMIT the bot instantly switches
# to the next key and sends the exhausted key's email to your Telegram PV.
# Usage counters persist in Upstash Redis REST (free tier) so they survive
# restarts, redeploys and even deploys on a DIFFERENT Railway account.
# Without Upstash they fall back to a local file that resets on redeploy.
CREATORCRAWL_API_KEYS=cc_replace-with-key-1|you1@example.com,cc_replace-with-key-2|you2@example.com
CREATORCRAWL_KEY_LIMIT=50
UPSTASH_REDIS_REST_URL=https://replace-with-your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# --- AI (v3: prexzy Gemini by default — free, NO API KEY needed) ---
# Provider: prexzy (default) | huggingface | cohere | mistral | off
# FIX (v3): the default provider is now the free Google Gemini endpoint at
# https://prexzyapis.com/ai/gemini (docs: https://docs.prexzyapis.com).
# It requires NO AI_API_KEY — /ask, the Persian summarizer and tag
# suggestions all work out of the box. HuggingFace/Cohere/Mistral remain
# selectable (they DO need AI_API_KEY); "off" disables AI entirely.
AI_PROVIDER=prexzy
# Only needed when AI_PROVIDER is huggingface/cohere/mistral:
# https://huggingface.co/settings/tokens (free) |
# https://dashboard.cohere.com/api-keys (trial) | https://console.mistral.ai (free tier)
AI_API_KEY=
# Defaults per provider: gemini (prexzy) / Phi-3.5-mini-instruct / command-r-08-2024 / mistral-small-latest
AI_MODEL=
AI_RATE_PER_MINUTE=20
AI_TIMEOUT_SECONDS=30
AI_SUMMARY_ENABLED=true

# --- SQLite store (additive; users.json untouched). Railway disk is
# ephemeral — the store rebuilds automatically after each redeploy.
MZ_DB_PATH=mz_data.db

# --- Feature flags (each new capability can be disabled before activation) ---
BOOKMARKS_ENABLED=true
AUTOSHARE_ENABLED=true
USER_STATS_ENABLED=true
DEDUPE_ENABLED=true
SCHEDULER_ENABLED=true
EXACT_SIZES_ENABLED=true
PERF_CACHE_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true

# --- Logging: "json" for structured JSON logs, anything else = human text ---
LOG_FORMAT=text
